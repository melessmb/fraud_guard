APP_NAME=fraud-detection-ouest-afrique
DEBUG=false
API_PREFIX=/api/v1

# Clé de hachage interne — générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX

# CORS production — liste de domaines séparés par virgule
CORS_ORIGINS=https://dashboard.monapp.ci,https://api.monapp.sn

DATABASE_URL=postgresql://postgres:STRONG_PASSWORD@db:5432/fraud_ouest_afrique
REDIS_URL=redis://redis:6379/0
PROMETHEUS_ENABLED=true

# Keycloak — IdP centralisé (remplace les API keys et JWT internes)
# En Docker : KEYCLOAK_URL=http://keycloak:8080
# En local   : KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=fraudguard
