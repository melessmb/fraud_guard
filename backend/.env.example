APP_NAME=fraud-detection-ouest-afrique
DEBUG=false
API_PREFIX=/api/v1

# Clé JWT — générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX

# Clé admin — accès endpoints de gestion (créer tenant, promouvoir modèle)
ADMIN_API_KEY=REPLACE_WITH_RANDOM_ADMIN_KEY

# CORS production — liste de domaines séparés par virgule
CORS_ORIGINS=https://dashboard.monapp.ci,https://api.monapp.sn

ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=postgresql://postgres:STRONG_PASSWORD@db:5432/fraud_ouest_afrique
REDIS_URL=redis://redis:6379/0
PROMETHEUS_ENABLED=true
