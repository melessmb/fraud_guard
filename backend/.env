app_name=fraud-detection-ouest-afrique
debug=true
api_prefix=/api/v1
secret_key=dev-secret-key-change-in-production
cors_origins=*
database_url=postgresql://postgres:postgres@localhost:5432/fraud_ouest_afrique
redis_url=redis://localhost:6379/0
prometheus_enabled=true

# Keycloak (démarrer avec : docker compose up keycloak)
keycloak_url=http://localhost:8080
keycloak_realm=fraudguard
