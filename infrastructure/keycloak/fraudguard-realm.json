{
  "realm": "fraudguard",
  "displayName": "FraudGuard",
  "enabled": true,
  "accessTokenLifespan": 3600,
  "refreshTokenMaxReuse": 0,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrateur de la plateforme FraudGuard (\u00e9quipe interne)"
      },
      {
        "name": "tenant_admin",
        "description": "Administrateur d'une entreprise cliente (banque, op\u00e9rateur mobile money)"
      },
      {
        "name": "developer",
        "description": "\u00c9quipe technique d'une entreprise cliente \u2014 scoring, webhooks, configuration"
      },
      {
        "name": "compliance",
        "description": "\u00c9quipe conformit\u00e9 d'une entreprise cliente \u2014 alertes et rapports BCEAO"
      },
      {
        "name": "tenant",
        "description": "Syst\u00e8me technique d'une entreprise cliente \u2014 acc\u00e8s API scoring uniquement"
      }
    ]
  },
  "clients": [
    {
      "clientId": "fraudguard-api",
      "name": "FraudGuard API",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "fraudguard-dashboard",
      "name": "Dashboard Admin",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8501/*",
        "http://127.0.0.1:8501/*"
      ],
      "webOrigins": [
        "http://localhost:8501",
        "http://127.0.0.1:8501"
      ]
    },
    {
      "clientId": "fraudguard-tenants",
      "name": "FraudGuard Tenants (M2M)",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "tenant-client-secret-change-in-prod",
      "redirectUris": [
        "*"
      ]
    }
  ],
  "users": [
    {
      "username": "fraudguard-admin",
      "enabled": true,
      "email": "admin@fraudguard.local",
      "firstName": "FraudGuard",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "Admin1234!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ],
      "emailVerified": true,
      "requiredActions": []
    },
    {
      "username": "tenant-admin-demo",
      "enabled": true,
      "email": "tenant-admin@fraudguard.local",
      "firstName": "Tenant",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "TenantAdmin1234!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "tenant_admin"
      ],
      "emailVerified": true,
      "requiredActions": []
    },
    {
      "username": "compliance-demo",
      "enabled": true,
      "email": "compliance@fraudguard.local",
      "firstName": "Compliance",
      "lastName": "Demo",
      "credentials": [
        {
